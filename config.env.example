# homelab-healthcheck configuration
# Copy to /opt/homelab-healthcheck/config.env and edit as needed.
# All values below are defaults — uncomment and change to override.

# Disk usage thresholds (percent)
#DISK_WARN_PCT=80
#DISK_CRIT_PCT=90

# Memory thresholds (percent)
#MEM_WARN_PCT=85
#MEM_CRIT_PCT=95

# Swap threshold (percent)
#SWAP_WARN_PCT=50

# CPU load warning multiplier (warn if 5m load > cores * multiplier)
#LOAD_WARN_MULTIPLIER=1

# Docker restart count warning threshold
#DOCKER_RESTART_WARN=3

# History retention (days) — set to 0 to disable
#HISTORY_RETENTION_DAYS=90

# Certificate expiry warning thresholds (days)
#CERT_WARN_DAYS=14
#CERT_CRIT_DAYS=7

# Domains to check for certificate expiry (space-separated)
# If empty, auto-discovers from Traefik's acme.json (if available)
#CERT_DOMAINS=""
